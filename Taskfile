#!/usr/bin/env bash
# =========================================================
# Taskfile gives you a set of quick tasks for your project
# More info: https://github.com/Enrise/Taskfile
# =========================================================

function task:test { ## Run every test
	task:vet
	# -race is not belt and braces here: fonts.Set caches faces in a map and
	# shares an sfnt.Buffer, and the test that covers concurrent access to it
	# can only see the fault through the race detector.
	go test -race ./...
}

function task:vet { ## Run go vet
	go vet ./...
}

function task:build { ## Build the binary
	go build -o codeshot ./cmd/codeshot
}

function task:golden { ## Rewrite the golden images after a deliberate change
	go test ./internal/adapters/render/raster/ -update
}

function task:demo { ## Take a shot of ls, to look at
	task:build
	# A plain `>` redirect never touches a pty, so `ls` never gets the \r a
	# terminal would add, and the render stair-steps. script(1) opens a real
	# pty around the command instead - BSD (macOS) script takes the command
	# as trailing arguments, GNU (Linux) script only runs one-shot commands
	# through -c, hence the branch.
	if [[ "$(uname)" == "Darwin" ]]; then
		script -q /tmp/codeshot-demo.ansi ls -G -la
	else
		script -qc "ls --color=always -la" /tmp/codeshot-demo.ansi
	fi
	./codeshot render /tmp/codeshot-demo.ansi demo.png --command "ls -la"
}

function task:fmt { ## Format everything
	gofmt -w .
}

function task:help { ## Show this help
	grep -E '^function task:.*##' "$0" | sed 's/function task:/  /; s/ *{ *## /\t/' | expand -t 24
}

"task:${1:-help}" "${@:2}"
